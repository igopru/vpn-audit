# === Flask ===
SECRET_KEY=change-me-to-openssl-rand-hex-32
FLASK_DEBUG=0
SESSION_TIMEOUT_MINUTES=480

# === Database ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vpn_audit
DB_PASSWORD=strong_password_here
DB_NAME=vpn_audit

# === Active Directory / LDAP ===
LDAP_SERVER=ldap://dc1.example.com
LDAP_BIND_DN=CN=svc_vpn_audit,OU=ServiceAccounts,DC=example,DC=com
LDAP_BIND_PASSWORD=service_account_password
LDAP_BASE_DN=DC=example,DC=com
LDAP_GROUP_DN=CN=VPN-Access,OU=SecurityGroups,DC=example,DC=com

# === Email / SMTP ===
EMAIL_ENABLED=1
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="VPN Audit System"
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USER=smtp_user@example.com
SMTP_PASSWORD=smtp_password

# === Business Logic ===
VPN_INACTIVE_DAYS=31
VPN_WHITELIST=
ADMIN_USERNAME_PATTERN=^sysadmin\d+$
VPN_DRY_RUN=1
EMAIL_TEST_OVERRIDE=admin@example.com

# === Paths & Timezone ===
LOG_DIR=/opt/vpn-audit/logs
TIMEZONE=Europe/Moscow
