# Flask
SECRET_KEY=generate-long-random-string-here
FLASK_DEBUG=0

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vpn_audit
DB_PASSWORD=change_me
DB_NAME=vpn_audit

# AD/LDAP
LDAP_SERVER=ldap://dc1.yourdomain.local
LDAP_BIND_DN=CN=svc_vpn_audit,OU=ServiceAccounts,DC=yourdomain,DC=local
LDAP_BIND_PASSWORD=service_account_password
LDAP_BASE_DN=DC=yourdomain,DC=local
LDAP_GROUP_DN=CN=VPN-Access,OU=Groups,DC=yourdomain,DC=local

# App
VPN_INACTIVE_DAYS=30
VPN_WHITELIST=svc_backup,admin.vip
TIMEZONE=Europe/Moscow
LOG_DIR=/opt/vpn-audit/logs
